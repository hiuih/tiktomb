{
  "name": "tiktok-desktop",
  "version": "1.0.0",
  "description": "Unofficial native macOS wrapper for TikTok Web",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.tiktokdesktop",
    "productName": "TikTomb",
    "files": [
      "main.js",
      "splash.html",
      "build-assets/icon-512.png",
      "build-assets/icon.icns",
      "build-assets/icon.ico"
    ],
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "TikTok needs camera access to record videos and go live.",
        "NSMicrophoneUsageDescription": "TikTok needs microphone access to record videos and go live.",
        "NSMicrophoneUsageDescriptionMac": "TikTok needs microphone access to record videos and go live.",
        "LSMinimumSystemVersion": "11.0"
      }
    }
  }
}
